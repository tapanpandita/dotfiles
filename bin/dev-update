#!/usr/bin/env bash
# One-shot updater for the whole Neovim dev toolchain: Homebrew (Neovim),
# node (nvm LTS), vim-plug plugins + treesitter parsers, and mason LSP
# servers/tools. Run this every week or two — it's on-demand on purpose so
# you're at the keyboard if an update misbehaves.
set -uo pipefail

say() { printf '\n\033[1;34m==> %s\033[0m\n' "$1"; }

say "Neovim (Homebrew)"
if command -v brew >/dev/null 2>&1; then
    brew update && brew upgrade neovim
    nvim --version | head -1
else
    echo "brew not found, skipping Neovim upgrade"
fi

say "Node (nvm LTS)"
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1091
    . "$NVM_DIR/nvm.sh"
    nvm install --lts && nvm alias default 'lts/*' && hash -r
    echo "node $(node --version)"
else
    echo "nvm not found, skipping Node upgrade"
fi

say "Plugins (vim-plug) + treesitter parsers"
nvim --headless -c 'PlugUpgrade' -c 'PlugUpdate --sync' -c 'TSUpdateSync' -c 'qa'

say "LSP servers & tools (mason)"
nvim --headless -c "luafile $HOME/.config/nvim/scripts/mason_update.lua" -c 'qa'

say "Done. Restart Neovim to pick everything up."
